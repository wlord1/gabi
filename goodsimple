<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Times Table Practice</title>
    <style>
        :root {
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --secondary: #10b981;
            --secondary-hover: #059669;
            --bg: #f8fafc;
            --text: #0f172a;
            --card-bg: #ffffff;
            --gray: #cbd5e1;
        }

        * {
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .container {
            background: var(--card-bg);
            padding: 2rem;
            border-radius: 16px;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
            max-width: 600px;
            width: 100%;
            text-align: center;
        }

        h1 {
            margin-top: 0;
            color: var(--primary);
        }

        /* Menu Styles */
        .settings-group {
            margin: 1.5rem 0;
            text-align: left;
        }

        .settings-group label {
            display: block;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .number-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }

        .checkbox-btn input {
            display: none;
        }

        .checkbox-btn span {
            display: block;
            padding: 10px;
            border: 2px solid var(--gray);
            border-radius: 8px;
            text-align: center;
            font-size: 1.2rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.2s;
        }

        .checkbox-btn input:checked + span {
            background-color: var(--primary);
            border-color: var(--primary);
            color: white;
        }

        .controls {
            display: flex;
            gap: 20px;
            margin-bottom: 1.5rem;
        }

        .control-item {
            flex: 1;
        }

        input[type="number"] {
            width: 100%;
            padding: 10px;
            font-size: 1.1rem;
            border: 2px solid var(--gray);
            border-radius: 8px;
            outline: none;
        }

        input[type="number"]:focus {
            border-color: var(--primary);
        }

        button {
            width: 100%;
            padding: 15px;
            font-size: 1.1rem;
            font-weight: bold;
            color: white;
            background-color: var(--primary);
            border: none;
            border-radius: 8px;
            cursor: pointer;
            margin-bottom: 10px;
            transition: background-color 0.2s;
        }

        button:hover {
            background-color: var(--primary-hover);
        }

        button.alt-btn {
            background-color: var(--secondary);
        }

        button.alt-btn:hover {
            background-color: var(--secondary-hover);
        }

        button.cancel-btn {
            background-color: #ef4444;
            margin-top: 2rem;
            width: auto;
            padding: 10px 20px;
        }

        /* Practice Area Styles */
        #practice-area, #complete-area {
            display: none;
        }

        .progress {
            font-size: 1.1rem;
            color: #64748b;
            font-weight: 600;
            margin-bottom: 2rem;
        }

        .equation-display {
            font-size: 5rem;
            font-weight: bold;
            margin: 2rem 0;
            min-height: 120px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
        }

        .answer {
            color: var(--secondary);
            opacity: 0;
            transition: opacity 0.2s;
        }

        .answer.visible {
            opacity: 1;
        }
    </style>
</head>
<body>

    <!-- MAIN MENU -->
    <div class="container" id="menu-area">
        <h1>Times Table Practice</h1>
        
        <div class="settings-group">
            <label>Select Tables (2-9):</label>
            <div class="number-grid">
                <label class="checkbox-btn"><input type="checkbox" value="2" class="table-cb"><span>2</span></label>
                <label class="checkbox-btn"><input type="checkbox" value="3" class="table-cb"><span>3</span></label>
                <label class="checkbox-btn"><input type="checkbox" value="4" class="table-cb"><span>4</span></label>
                <label class="checkbox-btn"><input type="checkbox" value="5" class="table-cb"><span>5</span></label>
                <label class="checkbox-btn"><input type="checkbox" value="6" class="table-cb"><span>6</span></label>
                <label class="checkbox-btn"><input type="checkbox" value="7" class="table-cb"><span>7</span></label>
                <label class="checkbox-btn"><input type="checkbox" value="8" class="table-cb"><span>8</span></label>
                <label class="checkbox-btn"><input type="checkbox" value="9" class="table-cb"><span>9</span></label>
            </div>
        </div>

        <div class="controls">
            <div class="control-item">
                <label for="duration">Duration (Seconds):</label>
                <input type="number" id="duration" min="1" max="10" value="5">
            </div>
            <div class="control-item">
                <label for="cycles">Number of Cycles:</label>
                <input type="number" id="cycles" min="1" value="1">
            </div>
        </div>

        <button onclick="startPractice(false)">Start Selected Tables</button>
        <button class="alt-btn" onclick="startPractice(true)">Start "Minimum 36" Mode</button>
    </div>

    <!-- PRACTICE AREA -->
    <div class="container" id="practice-area">
        <div class="progress" id="progress-text">Cycle 1/1 | Problem 1/8</div>
        
        <div class="equation-display">
            <span id="question-text">2 &times; 2 =</span>
            <span id="answer-text" class="answer">4</span>
        </div>

        <button class="cancel-btn" onclick="returnToMenu()">Stop & Return</button>
    </div>

    <!-- COMPLETE AREA -->
    <div class="container" id="complete-area">
        <h1>Practice Complete!</h1>
        <p style="font-size: 1.2rem; margin-bottom: 2rem; color: #64748b;">Great job finishing your cycles.</p>
        <button onclick="returnToMenu()">Return to Menu</button>
    </div>

    <script>
        let practiceList = [];
        let currentIndex = 0;
        let timerId = null;
        let totalCycles = 1;
        let currentCycle = 1;
        let setSize = 0;
        let durationMs = 5000;

        // Fisher-Yates shuffle algorithm to ensure random order without repeats
        function shuffleArray(array) {
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]];
            }
        }

        function startPractice(isMinimumMode) {
            let baseSet = [];

            if (isMinimumMode) {
                // Generate the 36 unique combinations (2x2 through 9x9, ignoring order)
                for (let i = 2; i <= 9; i++) {
                    for (let j = i; j <= 9; j++) {
                        // Randomly swap the visual order (e.g., 3x7 vs 7x3) to keep it fresh, 
                        // but mathematically it remains the 36 minimum set.
                        if (Math.random() > 0.5 && i !== j) {
                            baseSet.push({ a: j, b: i, ans: i * j });
                        } else {
                            baseSet.push({ a: i, b: j, ans: i * j });
                        }
                    }
                }
            } else {
                // Generate problems for the specifically selected tables
                const checkboxes = document.querySelectorAll('.table-cb:checked');
                const selectedTables = Array.from(checkboxes).map(cb => parseInt(cb.value));

                if (selectedTables.length === 0) {
                    alert("Please select at least one number from the grid.");
                    return;
                }

                selectedTables.forEach(t => {
                    for (let i = 2; i <= 9; i++) {
                        baseSet.push({ a: t, b: i, ans: t * i });
                    }
                });
            }

            // Get user settings
            totalCycles = parseInt(document.getElementById('cycles').value) || 1;
            let seconds = parseInt(document.getElementById('duration').value) || 5;
            
            // Constrain limits just in case
            if (seconds < 1) seconds = 1;
            if (seconds > 10) seconds = 10;
            if (totalCycles < 1) totalCycles = 1;

            durationMs = seconds * 1000;
            setSize = baseSet.length;
            practiceList = [];

            // Build the full playlist based on cycles
            for (let c = 0; c < totalCycles; c++) {
                let cycleSet = [...baseSet];
                shuffleArray(cycleSet); // Shuffle each cycle so it doesn't repeat identically
                practiceList = practiceList.concat(cycleSet);
            }

            // UI Setup
            currentIndex = 0;
            document.getElementById('menu-area').style.display = 'none';
            document.getElementById('complete-area').style.display = 'none';
            document.getElementById('practice-area').style.display = 'block';
            
            runNextQuestion();
        }

        function runNextQuestion() {
            if (currentIndex >= practiceList.length) {
                finishPractice();
                return;
            }

            // Calculate current cycle and position
            currentCycle = Math.floor(currentIndex / setSize) + 1;
            let problemInCycle = (currentIndex % setSize) + 1;

            // Update UI
            document.getElementById('progress-text').innerText = `Cycle ${currentCycle}/${totalCycles} | Problem ${problemInCycle}/${setSize}`;
            
            const currentProblem = practiceList[currentIndex];
            document.getElementById('question-text').innerHTML = `${currentProblem.a} &times; ${currentProblem.b} =`;
            
            const answerEl = document.getElementById('answer-text');
            answerEl.innerText = currentProblem.ans;
            answerEl.classList.remove('visible'); // Hide answer initially

            // Wait the selected duration, then show answer
            timerId = setTimeout(() => {
                answerEl.classList.add('visible'); // Show answer
                
                // Wait 2 seconds to let them see the answer, then move to next
                timerId = setTimeout(() => {
                    currentIndex++;
                    runNextQuestion();
                }, 2000); 

            }, durationMs);
        }

        function finishPractice() {
            clearTimeout(timerId);
            document.getElementById('practice-area').style.display = 'none';
            document.getElementById('complete-area').style.display = 'block';
        }

        function returnToMenu() {
            clearTimeout(timerId);
            document.getElementById('practice-area').style.display = 'none';
            document.getElementById('complete-area').style.display = 'none';
            document.getElementById('menu-area').style.display = 'block';
        }
    </script>
</body>
</html>
